# WhisperLiveKit engine with Streaming Sortformer diarization.
# Packages are installed into the whisperlivekit-sortformer engine target
# directory and injected with PYTHONPATH.
LIVE_DIALOGUE_TRANSLATOR_ASR_ENGINE=whisperlivekit_sortformer
LIVE_DIALOGUE_TRANSLATOR_WLK_BACKEND=faster-whisper
LIVE_DIALOGUE_TRANSLATOR_WLK_BACKEND_POLICY=simulstreaming
LIVE_DIALOGUE_TRANSLATOR_WLK_DIARIZATION_BACKEND=sortformer
LIVE_DIALOGUE_TRANSLATOR_WLK_PCM_INPUT=true
