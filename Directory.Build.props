<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <Authors>LiveDialogue Translator contributors</Authors>
    <Company>LiveDialogue Translator</Company>
    <Product>LiveDialogue Translator</Product>
    <Description>Local-first Windows captioning app with speaker diarization and translation.</Description>
    <Copyright>Copyright (c) 2026 LiveDialogue Translator contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Me-in-U/LiveDialogue-Translator</RepositoryUrl>
  </PropertyGroup>
</Project>
