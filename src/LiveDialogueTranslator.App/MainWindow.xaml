                                             GroupName="DiarizationModel"
                                             Height="26"
                                             Content="Community-1"
                                             Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="DiarizationDiartRadio"
                                             GroupName="DiarizationModel"
                                             Height="26"
                                             Content="Diart"
                                             Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="DiarizationSortformerRadio"
                                             GroupName="DiarizationModel"
                                             Height="26"
                                             Content="Sortformer"
                                             Checked="RestartSetting_CheckedChanged" />
