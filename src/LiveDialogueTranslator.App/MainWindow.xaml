                                             GroupName="DiarizationPreset"
                                             Height="26"
                                             Content="Sensitive"
                                             Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="DiarizationPresetBalancedRadio"
                                             GroupName="DiarizationPreset"
                                             Height="26"
                                             Content="Balanced"
                                             Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="DiarizationPresetStableRadio"
                                             GroupName="DiarizationPreset"
                                             Height="26"
                                             Content="Stable"
                                             Checked="RestartSetting_CheckedChanged" />
                            </UniformGrid>
                            <CheckBox x:Name="DiartManualCheck"
                                      Height="24"
                                      Margin="0,7,0,0"
                                      Content="Manual Diart tuning"
                                      Checked="RestartSetting_CheckedChanged"
                                      Unchecked="RestartSetting_CheckedChanged" />
                            <TextBlock x:Name="DiartManualDescriptionText"
                                       Margin="2,2,0,3"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Grid x:Name="DiartManualPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DiartDurationLabel" Grid.Row="0" Grid.Column="0" Margin="2,4,0,2" Text="Duration" />
                                <TextBox x:Name="DiartDurationBox" Grid.Row="1" Grid.Column="0" Height="28" TextChanged="RestartSetting_TextChanged" />
                                <TextBlock x:Name="DiartStepLabel" Grid.Row="0" Grid.Column="2" Margin="2,4,0,2" Text="Step" />
                                <TextBox x:Name="DiartStepBox" Grid.Row="1" Grid.Column="2" Height="28" TextChanged="RestartSetting_TextChanged" />
                                <TextBlock x:Name="DiartLatencyLabel" Grid.Row="2" Grid.Column="0" Margin="2,6,0,2" Text="Latency" />
                                <TextBox x:Name="DiartLatencyBox" Grid.Row="3" Grid.Column="0" Height="28" TextChanged="RestartSetting_TextChanged" />
                                <TextBlock x:Name="DiartTauLabel" Grid.Row="2" Grid.Column="2" Margin="2,6,0,2" Text="Tau" />
                                <TextBox x:Name="DiartTauBox" Grid.Row="3" Grid.Column="2" Height="28" TextChanged="RestartSetting_TextChanged" />
                                <TextBlock x:Name="DiartRhoLabel" Grid.Row="4" Grid.Column="0" Margin="2,6,0,2" Text="Rho" />
                                <TextBox x:Name="DiartRhoBox" Grid.Row="5" Grid.Column="0" Height="28" TextChanged="RestartSetting_TextChanged" />
                                <TextBlock x:Name="DiartDeltaLabel" Grid.Row="4" Grid.Column="2" Margin="2,6,0,2" Text="Delta" />
                                <TextBox x:Name="DiartDeltaBox" Grid.Row="5" Grid.Column="2" Height="28" TextChanged="RestartSetting_TextChanged" />
                            </Grid>
                            <TextBlock x:Name="SpeakersLabel" Margin="2,7,0,3" Text="Speakers" />
                            <UniformGrid x:Name="SpeakerCountPanel" Columns="4" Margin="0,1,0,0">
                                <RadioButton x:Name="MaxSpeakers1Radio" Content="1" GroupName="SpeakerCount" Tag="auto:1" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers2Radio" Content="2" GroupName="SpeakerCount" Tag="auto:2" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers3Radio" Content="3" GroupName="SpeakerCount" Tag="auto:3" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers4Radio" Content="4" GroupName="SpeakerCount" Tag="auto:4" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers5Radio" Content="5" GroupName="SpeakerCount" Tag="auto:5" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers6Radio" Content="6" GroupName="SpeakerCount" Tag="auto:6" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers7Radio" Content="7" GroupName="SpeakerCount" Tag="auto:7" Height="23" Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="MaxSpeakers8Radio" Content="8" GroupName="SpeakerCount" Tag="auto:8" Height="23" Checked="RestartSetting_CheckedChanged" />
                            </UniformGrid>
                            <TextBlock x:Name="SpeakerModeLabel" Margin="2,6,0,2" Text="Speaker Mode" />
                            <UniformGrid x:Name="SpeakerCountModePanel" Columns="2" Margin="0,1,0,0">
                                <RadioButton x:Name="SpeakerModeActiveMaxRadio"
                                             Content="Max active"
                                             GroupName="SpeakerCountMode"
                                             Height="23"
                                             Checked="RestartSetting_CheckedChanged" />
                                <RadioButton x:Name="SpeakerModeExactRadio"
                                             Content="Exact"
                                             GroupName="SpeakerCountMode"
                                             Height="23"
                                             Checked="RestartSetting_CheckedChanged" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Margin="0,0,7,0" Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="SettingsTranslationGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Translation" />
                            <TextBlock x:Name="TranslateApiLabel" Margin="2,0,0,4" Text="Translate API" />
                            <ComboBox x:Name="TranslateProviderBox" Height="28" SelectionChanged="TranslationSetting_SelectionChanged">
                                <ComboBoxItem x:Name="TranslateProviderGoogleItem" Content="Google" Tag="Google" />
                                <ComboBoxItem x:Name="TranslateProviderGoogle2Item" Content="Google2" Tag="Google2" />
                                <ComboBoxItem x:Name="TranslateProviderOllamaItem" Content="Ollama" Tag="Ollama" />
                                <ComboBoxItem x:Name="TranslateProviderOpenAIItem" Content="OpenAI" Tag="OpenAI" />
                                <ComboBoxItem x:Name="TranslateProviderOpenRouterItem" Content="OpenRouter" Tag="OpenRouter" />
                                <ComboBoxItem x:Name="TranslateProviderDeepLItem" Content="DeepL" Tag="DeepL" />
                                <ComboBoxItem x:Name="TranslateProviderYoudaoItem" Content="Youdao" Tag="Youdao" />
                                <ComboBoxItem x:Name="TranslateProviderBaiduItem" Content="Baidu" Tag="Baidu" />
                                <ComboBoxItem x:Name="TranslateProviderMTranServerItem" Content="MTranServer" Tag="MTranServer" />
                                <ComboBoxItem x:Name="TranslateProviderLibreTranslateItem" Content="LibreTranslate" Tag="LibreTranslate" />
                            </ComboBox>
                            <TextBlock x:Name="TargetLanguageLabel" Margin="2,7,0,3" Text="Target Language" />
                            <ComboBox x:Name="TargetLanguageBox" Height="28" MaxDropDownHeight="220" SelectionChanged="TranslationSetting_SelectionChanged">
                                <ComboBoxItem Content="ko-KR" Tag="ko" />
                                <ComboBoxItem Content="en-US" Tag="en" />
                                <ComboBoxItem Content="en-GB" Tag="en" />
                                <ComboBoxItem Content="ja-JP" Tag="ja" />
                                <ComboBoxItem Content="zh-CN" Tag="zh-CN" />
                                <ComboBoxItem Content="zh-TW" Tag="zh-TW" />
                                <ComboBoxItem Content="fr-FR" Tag="fr" />
                                <ComboBoxItem Content="de-DE" Tag="de" />
                                <ComboBoxItem Content="th-TH" Tag="th" />
                                <ComboBoxItem Content="ru-RU" Tag="ru" />
                                <ComboBoxItem Content="es-ES" Tag="es" />
                                <ComboBoxItem Content="pt-BR" Tag="pt" />
                                <ComboBoxItem Content="tr-TR" Tag="tr" />
                                <ComboBoxItem Content="ar-SA" Tag="ar" />
                            </ComboBox>
                            <Button x:Name="TranslateApiSettingsButton" Height="27" Margin="0,6,0,0" Click="TranslateApiSettingsButton_Click">Open</Button>
                            <TextBlock x:Name="CaptionDisplayModeLabel" Margin="2,7,0,2" Text="Display" />
                            <RadioButton x:Name="DisplayOriginalRadio" Height="19" Content="Original" GroupName="CaptionDisplayMode" Checked="ImmediateSetting_CheckedChanged" />
                            <RadioButton x:Name="DisplayTranslatedRadio" Height="19" Content="Translated" GroupName="CaptionDisplayMode" Checked="ImmediateSetting_CheckedChanged" />
                            <RadioButton x:Name="DisplayBothRadio" Height="19" Content="Both" GroupName="CaptionDisplayMode" Checked="ImmediateSetting_CheckedChanged" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="SettingsOverlayGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Overlay" />
                            <TextBlock x:Name="OverlaySettingsLabel" Margin="2,0,0,4" Text="Overlay" />
                            <Button x:Name="ResetOverlayButton" Height="28" Click="ResetOverlayButton_Click">Reset</Button>
                            <Button x:Name="OverlayColorsButton" Height="27" Margin="0,6,0,0" Click="OverlayColorsButton_Click">Colors</Button>
                            <TextBlock x:Name="CaptionDisplayLinesLabel" Margin="2,7,0,3" Text="Caption page lines" />
                            <ComboBox x:Name="CaptionDisplayLinesBox" Height="28" SelectionChanged="ImmediateSetting_SelectionChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="8" />
                            </ComboBox>
                            <TextBlock x:Name="OverlayDisplayLinesLabel" Margin="2,7,0,3" Text="Overlay lines" />
                            <ComboBox x:Name="OverlayDisplayLinesBox" Height="28" SelectionChanged="ImmediateSetting_SelectionChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="8" />
                            </ComboBox>
                            <TextBlock x:Name="OverlayOpacityLabel" Margin="2,7,0,3" Text="Opacity" />
                            <Slider x:Name="OverlayOpacitySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    ValueChanged="ImmediateSetting_ValueChanged" />
                            <CheckBox x:Name="OverlayClickThroughCheck"
                                      Height="24"
                                      Margin="0,6,0,0"
                                      Content="Click through"
                                      Checked="ImmediateSetting_CheckedChanged"
                                      Unchecked="ImmediateSetting_CheckedChanged" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="InfoPanel"
                        Margin="6,6,15,5"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Grid Margin="12,9,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="InfoWelcomeText" Grid.Row="0" TextWrapping="Wrap" />
                        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrushSoft}" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="InfoLinksTitle" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0">
                                    <Run x:Name="InfoProjectLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="ProjectLink_Click">
                                        <Run Text="GitHub" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0">
                                    <Run x:Name="InfoReferenceLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="ReferenceLink_Click">
                                        <Run Text="LiveCaptions-Translator" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run x:Name="InfoAsrLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="FasterWhisperLink_Click">
                                        <Run Text="Faster-Whisper" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="QwenAsrLink_Click">
                                        <Run Text="Qwen3-ASR" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="WhisperLiveKitLink_Click">
                                        <Run Text="WhisperLiveKit" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="WhisperXLink_Click">
                                        <Run Text="WhisperX" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run x:Name="InfoDiarizationLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="PyannoteLink_Click">
                                        <Run Text="pyannote Community-1" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="DiartLink_Click">
                                        <Run Text="Diart" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="SortformerLink_Click">
                                        <Run Text="Sortformer" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run x:Name="InfoSpeechSeparationLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="MossFormer2Link_Click">
                                        <Run Text="MossFormer2_SS_16K" />
                                    </Hyperlink>
                                    <Run Text=", " />
                                    <Hyperlink Click="SepFormerLink_Click">
                                        <Run Text="SepFormer WHAMR16k" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0">
                                    <Run x:Name="InfoLicenseLabelRun" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Hyperlink Click="LicenseLink_Click">
                                        <Run Text="Apache-2.0" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock x:Name="InfoRuntimeTitle" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0">
                                    <Run x:Name="InfoVersionLabelRun" FontWeight="SemiBold" />
                                    <Run x:Name="InfoVersionRun" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run x:Name="InfoRuntimeLabelRun" FontWeight="SemiBold" />
                                    <Run x:Name="InfoRuntimeRun" />
                                </TextBlock>
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Button x:Name="OpenModelsFolderButton" Width="128" Height="26" Padding="0" Click="OpenModelsFolder_Click" />
                                    <Button x:Name="OpenRuntimeFolderButton" Width="132" Height="26" Margin="8,0,0,0" Padding="0" Click="OpenRuntimeFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock x:Name="InfoDataTitle" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                                    <Run x:Name="InfoStorageLabelRun" FontWeight="SemiBold" />
                                    <Run x:Name="InfoStorageRun" />
                                </TextBlock>
                                <TextBlock x:Name="InfoPrivacyText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ConsolePanel"
                        Margin="6,6,15,5"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Grid Margin="10,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="ConsoleTitleText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Python Console" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="ConsoleClearButton"
                                        Width="88"
                                        Height="24"
                                        Padding="0"
                                        Click="ConsoleClearButton_Click"
                                        Content="Clear logs" />
                                <ToggleButton x:Name="ConsoleKeepBottomButton"
                                              Width="96"
                                              Height="24"
                                              Margin="6,0,0,0"
                                              Padding="0"
                                              Style="{StaticResource ConsoleKeepBottomButtonStyle}"
                                              Click="ConsoleKeepBottomButton_Click"
                                              Content="Keep bottom" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="ConsoleTextBox"
                                 Grid.Row="1"
                                 Margin="0,6,0,0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
