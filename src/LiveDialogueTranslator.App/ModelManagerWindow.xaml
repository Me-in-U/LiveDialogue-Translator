<Window x:Class="LiveDialogueTranslator.App.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Manager"
        Width="640"
        Height="430"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" Text="Local model setup" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,8,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Models are stored under LocalAppData. Speaker diarization runs locally with pyannote/speaker-diarization-community-1." />
        <TextBlock x:Name="AccessNoticeText"
                   Grid.Row="2"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="Accept the Community-1 model terms, create a Hugging Face token, paste it below, then save." />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TokenLabel" VerticalAlignment="Center" Text="HF Token" />
            <PasswordBox x:Name="TokenBox"
                         Grid.Column="1"
                         Padding="8,4"
                         Background="{StaticResource PanelAltBrush}"
                         BorderBrush="{StaticResource BorderBrushSoft}"
                         Foreground="{StaticResource TextBrush}" />
            <Button x:Name="GetTokenButton" Grid.Column="2" Margin="8,0,0,0" Click="OpenTokenPage_Click" ToolTip="Open Hugging Face access token page">Get Token</Button>
            <Button x:Name="CheckAccessButton" Grid.Column="3" Margin="8,0,0,0" Click="CheckAccessButton_Click">Check</Button>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ModelTermsLabel" VerticalAlignment="Center" Text="Model Terms" />
            <WrapPanel Grid.Column="1">
                <Button x:Name="CommunityTermsButton" Width="150" Margin="0,0,8,0" Click="OpenCommunityTerms_Click" ToolTip="Open Community-1 model access page">Community-1</Button>
                <Button x:Name="DiartSegmentationTermsButton" Width="150" Margin="0,0,8,0" Click="OpenDiartSegmentationTerms_Click" ToolTip="Open pyannote segmentation model access page">Segmentation</Button>
                <Button x:Name="DiartEmbeddingTermsButton" Width="150" Click="OpenDiartEmbeddingTerms_Click" ToolTip="Open pyannote embedding model access page">Embedding</Button>
            </WrapPanel>
        </Grid>

        <TextBox x:Name="OutputBox" Grid.Row="5" Margin="0,12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OpenFolderButton" Width="110" Margin="0,0,8,0" Click="OpenFolder_Click">Open Folder</Button>
            <Button x:Name="PrepareButton" Width="120" Margin="0,0,8,0" Click="PrepareButton_Click">Prepare</Button>
            <Button x:Name="SaveButton" Width="82" Click="SaveButton_Click">Save</Button>
        </StackPanel>
    </Grid>
</Window>
