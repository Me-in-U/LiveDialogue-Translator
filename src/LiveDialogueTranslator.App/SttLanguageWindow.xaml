<Window x:Class="LiveDialogueTranslator.App.SttLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STT Languages"
        Width="380"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HelpText"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Auto detects any language. Select one or more languages to restrict Whisper recognition."
                   TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" Margin="0,12">
            <StackPanel x:Name="LanguageRows" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" Width="82" Margin="0,0,8,0" Click="Cancel_Click">Cancel</Button>
            <Button x:Name="SaveButton" Width="82" Click="Save_Click">Save</Button>
        </StackPanel>
    </Grid>
</Window>
